# Local port for docker-compose.yml alone (http://localhost:8080)
PORT=8080

# Cloudflare Tunnel (docker-compose.tunnel.yml): the token from Zero Trust > Networks > Tunnels > your tunnel
TUNNEL_TOKEN=

# Only for the Caddy setup instead of the tunnel (docker-compose.https.yml)
DOMAIN=grobolsek.com
DATA_DIR=/portfolio
